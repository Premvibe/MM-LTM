{
  "rewrites": [
    {
      "source": "/mid-touch",
      "destination": "https://mm-ltm-mid-touch.vercel.app/mid-touch/"
    },
    {
      "source": "/mid-touch/",
      "destination": "https://mm-ltm-mid-touch.vercel.app/mid-touch/"
    },
    {
      "source": "/mid-touch/:path*",
      "destination": "https://mm-ltm-mid-touch.vercel.app/mid-touch/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
