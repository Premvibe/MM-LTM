{
  "redirects": [
    {
      "source": "/mid-touch",
      "destination": "https://mm-ltm-mid-touch.vercel.app/",
      "permanent": false
    },
    {
      "source": "/mid-touch/:path*",
      "destination": "https://mm-ltm-mid-touch.vercel.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
